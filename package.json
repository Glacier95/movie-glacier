{
  "name": "movie-glacier",
  "version": "0.7.4",
  "description": "Personal movie and series library for macOS and Windows",
  "author": "Movie Glacier",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Glacier95/movie-glacier.git"
  },
  "homepage": "https://github.com/Glacier95/movie-glacier#readme",
  "bugs": {
    "url": "https://github.com/Glacier95/movie-glacier/issues"
  },
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/icon.cjs && tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && vite build && node scripts/copy-wasm.cjs",
    "start": "electron .",
    "dist": "pnpm build && electron-builder --win nsis --x64",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "dist:mac": "pnpm build && node scripts/dist-mac.cjs",
    "dist:mac:intel": "pnpm build && node scripts/dist-mac.cjs --x64",
    "test:desktop": "node tests/desktop-ui.mjs",
    "test:metadata": "node tests/metadata-pipeline.mjs"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.1.0",
    "echarts": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.local.privatefilmlibrary",
    "productName": "Movie Glacier",
    "compression": "maximum",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/sql-wasm.wasm",
      "!**/node_modules/sql.js/dist/sql-asm*",
      "!**/node_modules/sql.js/dist/worker.*",
      "!**/node_modules/sql.js/dist/*debug*",
      "!**/node_modules/sql.js/dist/*browser*",
      "!**/node_modules/sql.js/dist/*.zip",
      "!**/node_modules/sql.js/dist/*.wasm",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-electron/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "artifactName": "Movie.Glacier.Setup.${version}.${ext}",
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Movie.Glacier-${version}-mac-${arch}.${ext}",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    }
  }
}
